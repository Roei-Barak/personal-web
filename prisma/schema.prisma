generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  roles    UserRole[]
}

model UserRole {
  id      Int    @id @default(autoincrement())
  user_id String
  role    String

  user User @relation(fields: [user_id], references: [id])
}
